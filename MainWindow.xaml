<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Fish.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Fish.Views">
    <Grid x:Name="Root" RequestedTheme="Default" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20" RowSpacing="14">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Width="38" Height="38">
                    <FontIcon Glyph="&#xE950;" FontSize="19" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                </Border>
                <StackPanel><TextBlock Text="Fish" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="WORLD OF WARCRAFT" FontSize="11" CharacterSpacing="140" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" AutomationProperties.Name="Angeln starten">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="12"/><TextBlock Text="Starten"/></StackPanel>
                </Button>
                <Button x:Name="StopButton" IsEnabled="False" Click="Stop_Click" ToolTipService.ToolTip="Angeln stoppen und Countdown abbrechen">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="12"/><TextBlock Text="Stop"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="True"/>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource SystemControlHighlightAccentBrush}"/>
                    <ProgressRing x:Name="SessionProgress" Width="26" Height="26" IsActive="False" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="Collapsed"/>
                </Grid>
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Activity}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Tolerances}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
        <RadioButtons AutomationProperties.Name="Hauptnavigation" x:Name="SectionNavigation" Grid.Row="3" MaxColumns="4" SelectedIndex="0" SelectionChanged="Section_Changed">
            <RadioButton Content="Übersicht"/>
            <RadioButton Content="Erkennung"/>
            <RadioButton Content="Aktionen"/>
<RadioButton Content="Anwendung"/>
        </RadioButtons>
        <Grid Grid.Row="4">
            <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled">
              <Grid x:Name="OverviewContent" RowSpacing="10" MinHeight="520" Height="{Binding ActualHeight, ElementName=OverviewPage}">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.Transitions><TransitionCollection><EntranceThemeTransition/></TransitionCollection></Grid.Transitions>
                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Protokoll" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                <Button Content="Kopieren" Click="CopyLog_Click" FontSize="11" Padding="10,4" ToolTipService.ToolTip="Gefilterte Einträge chronologisch kopieren"/>
                                <Button Content="Leeren" Click="ClearLog_Click" FontSize="11" Padding="10,4" ToolTipService.ToolTip="Angezeigte Protokolleinträge entfernen"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LogSearch" PlaceholderText="Protokoll durchsuchen …" AutomationProperties.Name="Protokoll durchsuchen" TextChanged="LogFilter_Changed"/>
                            <ComboBox x:Name="LogLevelFilter" Grid.Column="1" SelectedIndex="0" AutomationProperties.Name="Protokollstufe" SelectionChanged="LogFilter_Changed">
                                <ComboBoxItem Content="Alle Stufen"/><ComboBoxItem Content="Info"/><ComboBoxItem Content="Erfolg"/><ComboBoxItem Content="Warnung"/><ComboBoxItem Content="Fehler"/><ComboBoxItem Content="Warnung + Fehler"/>
                            </ComboBox>
                            <ComboBox x:Name="LogTimeFilter" Grid.Column="2" SelectedIndex="0" AutomationProperties.Name="Protokollzeitraum" SelectionChanged="LogFilter_Changed">
                                <ComboBoxItem Content="Gesamt"/><ComboBoxItem Content="5 Minuten"/><ComboBoxItem Content="15 Minuten"/><ComboBoxItem Content="60 Minuten"/>
                            </ComboBox>
                            <Button Grid.Column="3" Content="↺" AutomationProperties.Name="Protokollfilter zurücksetzen" ToolTipService.ToolTip="Filter zurücksetzen" Click="ResetLogFilter_Click"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding LogSummary}" FontSize="11" TextWrapping="Wrap"/>
                        <ListView x:Name="LogList" Grid.Row="3" AutomationProperties.Name="Gefiltertes Protokoll" ItemsSource="{Binding FilteredLog}" SelectionMode="None" Padding="0" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="28"/><Setter Property="Padding" Value="0,4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Category}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
                <views:PerformanceMonitor x:Name="PerformancePanel" Grid.Row="1"/>
              </Grid>
            </ScrollViewer>
            <ScrollViewer x:Name="DetectionPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Transitions><TransitionCollection><EntranceThemeTransition/></TransitionCollection></ScrollViewer.Transitions>
                <StackPanel x:Name="DetectionPanel" Spacing="10" Margin="0,0,4,4"/>
            </ScrollViewer>
            <ScrollViewer x:Name="FeaturesPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Transitions><TransitionCollection><EntranceThemeTransition/></TransitionCollection></ScrollViewer.Transitions>
                <StackPanel x:Name="FeaturesPanel" Spacing="10" Margin="0,0,4,4"/>
            </ScrollViewer>
            <ScrollViewer x:Name="ApplicationPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="0,0,4,12">
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
                        <TextBlock Text="Darstellung &amp; Bedienung" FontWeight="SemiBold"/>
                        <ComboBox x:Name="ThemeOption" Header="Farbschema" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="System"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/>
                        </ComboBox>
                        <CheckBox x:Name="ReduceMotionOption" Content="Bewegung reduzieren"/>
                        <TextBlock Text="Windows-Textskalierung und Kontrastdesigns werden übernommen. Strg+F öffnet die Logsuche, Escape leert die Suche, F1 öffnet die Einführung." FontSize="12" TextWrapping="Wrap"/>
                        <Button Content="Einführung anzeigen" Click="ShowIntroduction_Click"/>
                        <TextBlock Text="Fenster &amp; Tastatur" FontWeight="SemiBold"/>
                        <CheckBox x:Name="AlwaysOnTopOption" Content="Immer im Vordergrund"/>
                        <Button Content="Fenster auf diesem Monitor zentrieren" Click="CenterWindow_Click"/>
                        <CheckBox x:Name="MinimizeTrayOption" Content="Beim Minimieren in den Tray"/>
                        <CheckBox x:Name="CloseTrayOption" Content="Beim Schließen in den Tray (Beenden über Tray-Menü)"/>
                        <CheckBox x:Name="HotkeyOption" Content="Globaler Stop: Strg + Umschalt + F12"/>
                        <TextBlock x:Name="HotkeyStatus" FontSize="11" TextWrapping="Wrap"/>
                        <TextBlock Text="F5 Start · Umschalt+F5 Stop · Strg+1–4 Navigation · Strg+Umschalt+C Log kopieren · Strg+M Tray · Strg+Q Beenden" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SaveStatus" Text="Änderungen werden automatisch gespeichert." FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
                        <TextBlock Text="Benachrichtigungen" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ErrorNotifyOption" Content="Fehler"/>
                        <CheckBox x:Name="ActionNotifyOption" Content="Countdowns und Folgeaktionen"/>
                        <CheckBox x:Name="EndNotifyOption" Content="Sitzungsende"/>
                        <CheckBox x:Name="SoundNotifyOption" Content="Benachrichtigungston"/>
                        <Button Content="Testbenachrichtigung" Click="TestNotification_Click"/>
                        <TextBlock Text="Windows kann Meldungen bei aktivem Nicht-stören-Modus unterdrücken." FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
                        <TextBlock Text="Über Fish &amp; Updates" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionLabel"/>
                        <TextBox x:Name="RepositoryBox" Header="GitHub-Projekt" PlaceholderText="Besitzer/Projekt"/>
                        <Button x:Name="CheckUpdateButton" Content="Nach Updates suchen" Click="CheckUpdates_Click"/>
                        <TextBlock x:Name="UpdateStatus" Text="Updates werden nur auf Anfrage geprüft." FontSize="12" TextWrapping="Wrap"/>
                        <HyperlinkButton x:Name="ReleaseLink" Content="Release und Downloads öffnen" Visibility="Collapsed"/>
                        <TextBlock x:Name="ReleaseNotes" TextWrapping="Wrap" FontSize="11" IsTextSelectionEnabled="True" MaxHeight="160" TextTrimming="CharacterEllipsis"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
                        <TextBlock Text="Diagnose &amp; Fehlerberichte" FontWeight="SemiBold"/>
                        <TextBlock Text="Berichte enthalten Version, System, Sitzungszahlen, letzte Fehlermeldung und Protokoll. Sie bleiben lokal; es wird nichts automatisch versendet. Vor dem Teilen prüfen." TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Bericht speichern" Click="ExportDiagnostics_Click"/>
                            <Button Content="Ordner öffnen" Click="OpenDiagnostics_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="DiagnosticsStatus" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
