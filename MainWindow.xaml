<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Fish.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Fish.Views">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20" RowSpacing="14">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="10" Width="38" Height="38">
                    <FontIcon x:Name="BrandIcon" Glyph="" FontSize="20" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" />
                </Border>
                <StackPanel><TextBlock Text="Fish" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="WORLD OF WARCRAFT" FontSize="12" CharacterSpacing="140" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border x:Name="StartIndicator" BorderThickness="1" CornerRadius="8" Padding="8,3,3,3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StartLamp" Width="8" Height="8" VerticalAlignment="Center" />
                <Button x:Name="StartButton" Click="Start_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="13" /><TextBlock Text="Starten" /></StackPanel>
                </Button>
                  </StackPanel>
                </Border>
                <Border x:Name="StopIndicator" BorderThickness="1" CornerRadius="8" Padding="8,3,3,3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse x:Name="StopLamp" Width="8" Height="8" VerticalAlignment="Center" />
                <Button x:Name="StopButton" IsEnabled="False" Click="Stop_Click" ToolTipService.ToolTip="Angeln stoppen und Countdown abbrechen">
                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="13" /><TextBlock Text="Stop" /></StackPanel>
                </Button>
                  </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        <InfoBar x:Name="MessageBar" Grid.Row="1" IsOpen="False" IsClosable="True" />
        <Border Grid.Row="2" Style="{StaticResource Card}">
          <Grid>
            <Border x:Name="StatusAccent" Width="3" HorizontalAlignment="Left" CornerRadius="2" Margin="-8,0,0,0" />
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Width="26" Height="26" VerticalAlignment="Top" Margin="0,4,0,0">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
                    <ProgressRing x:Name="SessionProgress" Width="26" Height="26" IsActive="False" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" Spacing="5">
                    <views:AccentBadge x:Name="SessionBadge" Label="GESTOPPT" HorizontalAlignment="Left" />
                    <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Activity}" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Tolerances}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <TabView x:Name="SectionNavigation" Grid.Row="3" Height="48" TabWidthMode="Equal" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" SelectedIndex="0" SelectionChanged="Section_Changed">
            <TabViewItem Header="Übersicht" IsClosable="False" />
            <TabViewItem Header="Erkennung" IsClosable="False" />
            <TabViewItem Header="Aktionen" IsClosable="False" />
<TabViewItem Header="Anwendung" IsClosable="False" />
        </TabView>
        <Grid Grid.Row="4">
            <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled">
              <Grid x:Name="OverviewContent" RowSpacing="10" VerticalAlignment="Top">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.Transitions><TransitionCollection><EntranceThemeTransition /></TransitionCollection></Grid.Transitions>
                <Expander x:Name="LogSection" Header="Protokoll" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ListView Height="230" x:Name="LogList" ItemsSource="{Binding Log}" SelectionMode="None" Padding="0" HorizontalContentAlignment="Stretch">
                            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="0,4" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="10" Padding="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="12" Margin="0,2,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <views:AccentBadge Label="{Binding LevelText}" />
                                                <views:AccentBadge Label="{Binding Category}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView></Expander>
                <Expander x:Name="PreviewSection" Grid.Row="1" Header="Live" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <views:DetectionPreviews x:Name="PreviewPanel" />
                </Expander>
                <Expander Grid.Row="2" Header="Analyse" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <views:PerformanceMonitor x:Name="PerformancePanel" />
                </Expander>
              </Grid>
            </ScrollViewer>
            <ScrollViewer x:Name="DetectionPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Transitions><TransitionCollection><EntranceThemeTransition /></TransitionCollection></ScrollViewer.Transitions>
                <StackPanel x:Name="DetectionPanel" Spacing="10" Margin="0,0,4,4" />
            </ScrollViewer>
            <ScrollViewer x:Name="FeaturesPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Transitions><TransitionCollection><EntranceThemeTransition /></TransitionCollection></ScrollViewer.Transitions>
                <StackPanel x:Name="FeaturesPanel" Spacing="10" Margin="0,0,4,4" />
            </ScrollViewer>
            <ScrollViewer x:Name="ApplicationPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="0,0,4,12">
                    <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
                        <TextBlock Text="Darstellung &amp; Bedienung" FontWeight="SemiBold" />
                        <ComboBox x:Name="ThemeOption" Header="Farbschema" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Dark" /><ComboBoxItem Content="Light" />
                        </ComboBox>


                        <TextBlock Text="Fenster" FontWeight="SemiBold" />
                        <CheckBox x:Name="AlwaysOnTopOption" Content="Immer im Vordergrund" />

                        <CheckBox x:Name="MinimizeTrayOption" Content="Beim Minimieren in den Tray" />
                        <CheckBox x:Name="CloseTrayOption" Content="Beim Schließen in den Tray (Beenden über Tray-Menü)" />
                        <TextBlock x:Name="SaveStatus" Text="Änderungen werden automatisch gespeichert." FontSize="12" TextWrapping="Wrap" />
                    </StackPanel></Border>

                    <Border Style="{StaticResource Card}"><StackPanel Spacing="8">
                        <TextBlock Text="Über" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionLabel" />
                        <Button x:Name="CheckUpdateButton" Content="Nach Updates suchen" Click="CheckUpdates_Click" />
                    </StackPanel></Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
