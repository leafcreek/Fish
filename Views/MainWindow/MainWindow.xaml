<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Fish.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Fish.Views">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root" RequestedTheme="Light" Background="Transparent" Padding="12" RowSpacing="8">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource FishSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource FishStroke}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Background" Value="{StaticResource FishSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource FishStroke}" />
                <Setter Property="Foreground" Value="{StaticResource FishInk}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />
        <Border x:Name="StatusCard" Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E1F4ED" /><GradientStop Color="#F8FCFA" Offset="1" /></LinearGradientBrush>
            </Border.Background>
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Canvas IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Top" Width="100" Height="40" Opacity="0.09">
                    <Path Stroke="{StaticResource FishAccent}" StrokeThickness="1" Data="M 0,32 C 22,12 42,12 64,32 C 79,46 92,46 110,32 M 0,22 C 22,2 42,2 64,22 C 79,36 92,36 110,22 M 0,12 C 22,-8 42,-8 64,12 C 79,26 92,26 110,12" />
                </Canvas>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border x:Name="StatusBadge" Width="32" Height="32" CornerRadius="10" VerticalAlignment="Center">
                        <Grid><Ellipse x:Name="StatusDot" Width="8" Height="8" /><ProgressRing x:Name="SessionProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" /></Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="StatusText" Text="{Binding Status}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource FishInk}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Activity}" FontSize="12" Foreground="{StaticResource FishMuted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button x:Name="SessionButton" Grid.Column="2" Style="{StaticResource FishAction}" Click="Session_Click" AutomationProperties.Name="Starten" MinWidth="96" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6"><PathIcon x:Name="SessionButtonIcon" Width="11" Height="11" Data="M 1,0 L 11,6 L 1,12 Z" /><TextBlock x:Name="SessionButtonText" Text="Starten" FontSize="13" /></StackPanel>
                    </Button>
                </Grid>
                <Border x:Name="StepProgressPanel" Grid.Row="1" CornerRadius="6" Padding="4,2" Margin="-4,0">
                    <Border.BackgroundTransition><BrushTransition Duration="0:0:0.167" /></Border.BackgroundTransition>
                    <Grid RowSpacing="5">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="StepCaption" Text="Nächster Wurf" FontSize="11" Foreground="{StaticResource FishMuted}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="StepTimeText" Grid.Column="1" Text="0,0 / 0,0 s" FontSize="11" Foreground="{StaticResource FishMuted}" AutomationProperties.AutomationId="StepTimeText" />
                        </Grid>
                        <ProgressBar x:Name="StepTimeProgress" Grid.Row="1" Minimum="0" Maximum="1" Value="0" Height="8" MinHeight="8" CornerRadius="4" Background="{StaticResource FishTrack}" IsIndeterminate="False" AutomationProperties.Name="Schrittfortschritt" AutomationProperties.AutomationId="StepTimeProgress">
                            <ProgressBar.Resources><x:Double x:Key="ProgressBarTrackHeight">8</x:Double></ProgressBar.Resources>
                        </ProgressBar>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer x:Name="MainScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel x:Name="MainContent" Spacing="8">
                <Border x:Name="SettingsCard" Style="{StaticResource Card}" Padding="10"><StackPanel x:Name="SettingsPanel" Spacing="6" /></Border>
                <Expander x:Name="PreviewSection" IsExpanded="False" AutomationProperties.Name="Überwachung">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{StaticResource FishAccent}" /><TextBlock Text="Überwachung" FontSize="13" FontWeight="SemiBold" /></StackPanel>
                    </Expander.Header>
                    <views:DetectionPreviews x:Name="PreviewPanel" />
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
