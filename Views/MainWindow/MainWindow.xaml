<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Fish.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:Fish.Views">
    <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="10" RowSpacing="6">
        <Grid.Resources>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="10" />
            </Style>
            <Style TargetType="Expander">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="True" />
        <Border x:Name="StatusCard" Grid.Row="1" Style="{StaticResource Card}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border x:Name="StatusAccent" Width="3" CornerRadius="2" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{ThemeResource SystemControlHighlightAccentBrush}" />
                            <ProgressRing x:Name="SessionProgress" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="{Binding Status}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Button x:Name="SessionButton" Grid.Column="2" Click="Session_Click" AutomationProperties.Name="Starten" Padding="8,4" MinHeight="30" MinWidth="92" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon x:Name="SessionButtonIcon" Width="11" Height="11" Data="M 1,0 L 11,6 L 1,12 Z" /><TextBlock x:Name="SessionButtonText" Text="Starten" FontSize="13" /></StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Activity}" FontSize="12" TextWrapping="Wrap" />
                    <Border x:Name="StepProgressPanel" CornerRadius="4" Padding="4,2" Margin="-4,0">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="StepTimeText" Text="Kein aktiver Schritt · 0,0 / 0,0 s" FontSize="11" TextWrapping="Wrap" AutomationProperties.AutomationId="StepTimeText" />
                            <ProgressBar x:Name="StepTimeProgress" Minimum="0" Maximum="1" Value="0" Height="8" MinHeight="8" CornerRadius="4" IsIndeterminate="False" AutomationProperties.Name="Schrittfortschritt" AutomationProperties.AutomationId="StepTimeProgress">
                                <ProgressBar.Resources>
                                    <x:Double x:Key="ProgressBarTrackHeight">8</x:Double>
                                </ProgressBar.Resources>
                            </ProgressBar>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="MainScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="6">
                <Border Style="{StaticResource Card}"><StackPanel x:Name="SettingsPanel" Spacing="5" /></Border>
                <Expander x:Name="PreviewSection" Header="Überwachung" IsExpanded="False"><views:DetectionPreviews x:Name="PreviewPanel" /></Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
