<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Fish.App"
    RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fish">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <x:Double x:Key="TextControlThemeFontSize">13</x:Double>
            <!-- Suppress framework-provided tooltips as well as application hints. -->
            <Style TargetType="ToolTip"><Setter Property="Visibility" Value="Collapsed" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
