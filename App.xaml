<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Fish.App"
    RequestedTheme="Light"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fish">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
            <x:Double x:Key="TextControlThemeFontSize">13</x:Double>
            <SolidColorBrush x:Key="FishInk" Color="#193D3C" />
            <SolidColorBrush x:Key="FishMuted" Color="#586F6E" />
            <SolidColorBrush x:Key="FishAccent" Color="#087F73" />
            <SolidColorBrush x:Key="FishAmber" Color="#A36316" />
            <SolidColorBrush x:Key="FishSurface" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="FishStroke" Color="#20165E57" />
            <SolidColorBrush x:Key="FishTrack" Color="#D8E4E0" />
            <SolidColorBrush x:Key="FishPreviewBackground" Color="#ECF3F1" />
            <Style x:Key="FishAction" TargetType="Button">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Suppress framework-provided tooltips as well as application hints. -->
            <Style TargetType="ToolTip"><Setter Property="Visibility" Value="Collapsed" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
